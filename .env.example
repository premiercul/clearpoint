# Copy to .env.local and fill in (Supabase dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: WhatsApp number for footer links, digits only with country code (e.g. 2348012345678).
# If empty, the Support / Advertise links are hidden.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Optional: contact email shown on the Privacy page (falls back to the WhatsApp number above)
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: protects /api/keepalive. On Vercel, set the same value in the project env vars and the cron sends it automatically.
CRON_SECRET=

# Your public address (no trailing slash). Used for canonical links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
